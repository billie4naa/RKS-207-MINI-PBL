import socket
import threading
from transformers import pipeline
import os
import base64
from PIL import Image
from io import BytesIO

# Inisialisasi model AI menggunakan pipeline dari Hugging Face
chatbot = pipeline("conversational", model="microsoft/DialoGPT-medium")

# Fungsi untuk menangani koneksi client
def handle_client(client_socket):
    while True:
        try:
            message = client_socket.recv(1024).decode()  # Menerima pesan dari client
            if message:
                print(f"Received message: {message}")
                if message.lower() == 'exit':
                    break
                elif message.startswith("file:"):  # Jika pesan mengandung file
                    file_data = message.split(":", 1)[1]
                    with open("received_file", "wb") as file:
                        file.write(base64.b64decode(file_data))
                    response = "File received successfully."
                else:
                    response = chatbot(message)[0]['generated_text']  # Menjawab menggunakan chatbot
                client_socket.send(response.encode())  # Kirimkan respons kembali ke client
        except Exception as e:
            print(f"Error: {e}")
            break
    client_socket.close()

# Fungsi utama server
def run_server():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.bind(("0.0.0.0", 9999))
    server.listen(5)
    print("Server listening on port 9999...")
    
    while True:
        client_socket, _ = server.accept()
        client_handler = threading.Thread(target=handle_client, args=(client_socket,))
        client_handler.start()

if __name__ == "__main__":
    run_server()

import tkinter as tk
from tkinter import simpledialog
import socket
import base64
from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
import os

# Enkripsi dan dekripsi AES
def encrypt_aes(message, key):
    iv = os.urandom(16)
    cipher = Cipher(algorithms.AES(key), modes.CFB(iv), backend=default_backend())
    encryptor = cipher.encryptor()
    ciphertext = encryptor.update(message.encode()) + encryptor.finalize()
    return base64.b64encode(iv + ciphertext).decode()

def decrypt_aes(encrypted_message, key):
    encrypted_message = base64.b64decode(encrypted_message)
    iv = encrypted_message[:16]
    ciphertext = encrypted_message[16:]
    cipher = Cipher(algorithms.AES(key), modes.CFB(iv), backend=default_backend())
    decryptor = cipher.decryptor()
    return decryptor.update(ciphertext) + decryptor.finalize()

class ChatApp:
    def __init__(self, root, server_ip, server_port):
        self.root = root
        self.server_ip = server_ip
        self.server_port = server_port
        self.client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.client_socket.connect((self.server_ip, self.server_port))
        self.aes_key = os.urandom(32)  # AES 256-bit key
        self.setup_ui()

    def setup_ui(self):
        self.root.title("Chat App")

        self.text_area = tk.Text(self.root, width=50, height=20)
        self.text_area.pack()

        self.entry = tk.Entry(self.root, width=50)
        self.entry.pack()

        self.send_button = tk.Button(self.root, text="Send", command=self.send_message)
        self.send_button.pack()

        self.root.protocol("WM_DELETE_WINDOW", self.on_closing)

    def send_message(self):
        message = self.entry.get()
        if message:
            encrypted_message = encrypt_aes(message, self.aes_key)
            self.client_socket.send(encrypted_message.encode())
            self.text_area.insert(tk.END, f"You: {message}\n")
            self.entry.delete(0, tk.END)
            self.receive_message()

    def receive_message(self):
        encrypted_message = self.client_socket.recv(1024).decode()
        decrypted_message = decrypt_aes(encrypted_message, self.aes_key)
        self.text_area.insert(tk.END, f"Bot: {decrypted_message.decode()}\n")

    def on_closing(self):
        self.client_socket.close()
        self.root.quit()

if __name__ == "__main__":
    root = tk.Tk()
    app = ChatApp(root, "127.0.0.1", 9999)
    root.mainloop()

